# Copy to config/config.env and fill in. Never commit the real file.
PORT=4000
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/
# Optional, defaults to HOSP_MGMT_DEPLOY
DB_NAME=HOSP_MGMT_DEPLOY

# Exact origins of the two front-ends (no trailing slash)
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174

# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET_KEY=
JWT_EXPIRES=7d
COOKIE_EXPIRE=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to "development" for local http (uses SameSite=Lax, non-Secure cookies)
NODE_ENV=development
